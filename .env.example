# Copiez ce fichier en .env (jamais commité) pour lancer les agents sur votre ordinateur :
#   node --env-file=.env agents/compta/cli.js --mois 2026-10 --releve export.csv

# Clé API Claude (console.anthropic.com). Sans clé, les agents fonctionnent en mode « règles ».
ANTHROPIC_API_KEY=

# Planning : adresse secrète iCal de l'agenda Google de l'agence
PLANNING_ICS_URL=
# Brief hebdomadaire de l'équipe envoyé à cette adresse
PLANNING_EQUIPE_EMAIL=autoecole.autonome@gmail.com

# Comptabilité : destinataire du rapport mensuel
COMPTA_DESTINATAIRE=autoecole.autonome@gmail.com

# Envoi d'e-mails (Gmail : smtp.gmail.com, port 465, mot de passe d'application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=autoecole.autonome@gmail.com
SMTP_PASS=
SMTP_FROM=Auto-École Autonome <autoecole.autonome@gmail.com>
